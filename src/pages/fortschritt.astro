---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { curriculum } from '@/lib/curriculum';
import { withBase } from '@/lib/paths';
---

<BaseLayout
  title="Fortschritt"
  description="Lernfortschritt sichern, übertragen und zurücksetzen, Inhalte für offline speichern."
>
  <Breadcrumbs items={[{ label: 'Übersicht', href: withBase('') }, { label: 'Fortschritt' }]} />
  <h1>Dein Fortschritt</h1>
  <p class="lead">
    Der Fortschritt liegt nur in diesem Browser. Mit einer Exportdatei kannst du ihn sichern oder
    auf ein anderes Gerät übertragen.
  </p>

  <noscript>
    <p class="nojs">Für diese Seite wird JavaScript benötigt.</p>
  </noscript>

  <section class="offline" id="offline" data-offline hidden aria-labelledby="offline-title">
    <h2 id="offline-title">Offline lesen</h2>
    <p>
      Speichere alle Lektionen auf diesem Gerät, um sie ohne Internet zu lesen, etwa im Flugzeug.
      Visualisierungen, Quiz, Glossar und Suche funktionieren dann auch offline. Auf dem Handy
      kannst du die Seite zusätzlich zum Home-Bildschirm hinzufügen (iPhone: „Teilen“, dann „Zum
      Home-Bildschirm“), dann startet sie wie eine App.
    </p>
    <p class="offline-status" role="status" data-offline-status></p>
    <progress class="offline-bar" data-offline-progress hidden></progress>
    <div class="actions" data-offline-actions>
      <button type="button" class="btn primary" data-offline-save>
        Für offline speichern
      </button>
      <button type="button" class="btn" data-offline-remove hidden>
        Offline-Daten löschen
      </button>
    </div>
    <p class="hint">
      Tipp: Öffne die Seite vor einer Reise einmal mit Internet. Sie prüft dann, ob es neue Inhalte
      gibt. Manche Browser, vor allem Safari, löschen gespeicherte Daten nach einigen Wochen ohne
      Besuch.
    </p>
  </section>

  <div class="progress-tools" data-progress-page hidden>
    <p class="summary" data-progress-summary>
      0 von {curriculum.lessons.length} Lektionen erledigt.
    </p>
    <ul class="done-list" data-progress-list></ul>

    <h2>Sichern und übertragen</h2>
    <div class="actions">
      <button type="button" class="btn primary" data-export>
        Fortschritt exportieren
      </button>
      <label class="btn">
        Fortschritt importieren
        <input type="file" accept="application/json,.json" class="sr-only" data-import />
      </label>
    </div>
    <p class="hint">
      Beim Import wird zusammengeführt: Eine Lektion bleibt erledigt, wenn sie in diesem Browser
      oder in der Datei als erledigt markiert ist.
    </p>
    <p class="message" role="status" data-progress-message></p>

    <h2>Zurücksetzen</h2>
    <p>Entfernt den gesamten Fortschritt aus diesem Browser.</p>
    <button type="button" class="btn danger" data-reset>
      Fortschritt zurücksetzen
    </button>
  </div>

  <script>
    import '@/scripts/progress-page';
    import '@/scripts/offline';
  </script>
</BaseLayout>

<style>
  .offline {
    margin-bottom: 8px;
  }
  .offline-status {
    font-weight: 600;
  }
  .offline-bar {
    display: block;
    width: 100%;
    max-width: 420px;
    height: 8px;
    margin: 0 0 12px;
    accent-color: var(--accent);
  }
  .summary {
    font-size: 1.125rem;
    font-weight: 600;
  }
  .done-list {
    max-width: 80ch;
    padding-left: 20px;
  }
  .done-list:empty {
    display: none;
  }
  h2 {
    margin-top: 32px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .actions label {
    cursor: pointer;
  }
  .actions label:focus-within {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .hint {
    color: var(--muted);
    font-size: 14px;
    max-width: 80ch;
  }
  .message {
    font-weight: 600;
  }
  .message[data-kind='error'] {
    color: var(--bad);
  }
  .message[data-kind='ok'] {
    color: var(--ok);
  }
  .danger {
    color: var(--bad);
    border-color: var(--bad);
  }
  .nojs {
    color: var(--muted);
  }
</style>
